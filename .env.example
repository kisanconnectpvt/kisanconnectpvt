# KisanConnect — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Fly.io + Neon + Upstash + Vercel setup
# Run: export $(cat .env | xargs) before running deploy.sh

# ── Neon PostgreSQL ────────────────────────────────────────────────────────────
# Get from: neon.tech → your project → Dashboard → Connection string
# Select: Java / JDBC format
DATABASE_URL=jdbc:postgresql://HOST.neon.tech/kisanconnect?sslmode=require
DATABASE_USERNAME=your-neon-username
DATABASE_PASSWORD=your-neon-password

# ── Upstash Kafka ──────────────────────────────────────────────────────────────
# Get from: console.upstash.com → Kafka → your cluster → Details tab
KAFKA_URL=your-cluster.upstash.io:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# Copy the entire JAAS config line from Upstash Details tab:
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="your-user" password="your-pass";

# ── JWT Secret ─────────────────────────────────────────────────────────────────
# Generate a random secret with at least 32 bytes of entropy. Keep the same value
# across backend services and store it only in a local secret file/secret manager.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_API_KEY=replace-with-a-separate-random-service-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:30080

# ── Frontend (set in Vercel dashboard, not here) ───────────────────────────────
REACT_APP_USER_SERVICE_URL=https://kc-user-service.fly.dev
REACT_APP_PRODUCT_SERVICE_URL=https://kc-product-service.fly.dev
REACT_APP_ORDER_SERVICE_URL=https://kc-order-service.fly.dev
REACT_APP_PAYMENT_SERVICE_URL=https://kc-payment-service.fly.dev

# ── Razorpay keys for payment-service (use test keys for local development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
