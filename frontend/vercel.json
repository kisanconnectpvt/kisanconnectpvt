{
  "version": 2,
  "builds": [{"src": "package.json","use": "@vercel/static-build","config": {"distDir": "build"}}],
  "routes": [{"src": "/static/(.*)","dest": "/static/$1"},{"src": "/favicon.ico","dest": "/favicon.ico"},{"src": "/(.*)", "dest": "/index.html"}],
  "env": {
    "REACT_APP_USER_SERVICE_URL":    "@kc-user-service-url",
    "REACT_APP_PRODUCT_SERVICE_URL": "@kc-product-service-url",
    "REACT_APP_ORDER_SERVICE_URL":   "@kc-order-service-url"
  }
}